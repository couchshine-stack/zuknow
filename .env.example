# App
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=change-this-to-a-long-random-string

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@endpoint-pooler.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@endpoint.aws.neon.tech/neondb?sslmode=require"

# Admin panel /admin
ADMIN_EMAIL=admin@zuknow.in
ADMIN_PASSWORD=zuknow-admin-15

# Razorpay (key_id is public, key_secret stays on the server)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx

# WhatsApp OTP — https://otp.turnkeyinfotech.live/admin
WHATSAPP_OTP_BASE_URL=https://otp.turnkeyinfotech.live
WHATSAPP_CLIENT_ID=
WHATSAPP_API_KEY=

# After first boot, keys and security rules can also be edited in Admin → Settings (secrets encrypted in MySQL).
# Google Maps — enable Maps JavaScript API, Directions, Geocoding, Distance Matrix
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
